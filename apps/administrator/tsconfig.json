{
  "extends": "@edust/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@edust/ui": ["../../packages/ui/src"], // for ignore index.ts auto import time
      "@edust/ui/*": ["../../packages/ui/src/*"], // for import all related packages
      "@edust/types": ["../../packages/types/src/index.ts"],
      "@edust/utils": ["../../packages/utils/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/(root)/users",
    "../../packages/utils/src/extract-axios-error-message.ts",
    "../../packages/utils/src/convert-slug.ts"
  ],
  "exclude": ["node_modules"]
}
